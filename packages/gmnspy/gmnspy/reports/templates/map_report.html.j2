{#- gmnspy.reports.html_map Jinja template — single self-contained HTML.

Inputs (provided by gmnspy.reports.html_map.render_network_html):
  - title              : <title> + <h1> text
  - meta_subtitle      : optional one-liner under the H1 (e.g. spec_version)
  - counts             : list of [severity_str, n] for the top chips
  - leaflet_css        : full Leaflet CSS, inlined
  - leaflet_js         : full Leaflet JS, inlined
  - map_css            : map_report.css, inlined
  - map_js             : map_report.js, inlined
  - payload_json       : window.__GMNSPY_DATA__ JSON blob (markers, links, bbox)
  - issues             : list of issue dicts for the table (severity, code, table,
                         column, row, message, fix_hint, issue_id, edit_url, located)
  - filter_options     : {"severity": [...], "table": [...]}
  - located_count      : number of issues that resolved to a coord
  - unlocated          : list of issue dicts with no coord (issue_id + display fields)
-#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <style>{{ leaflet_css }}</style>
  <style>{{ map_css }}</style>
</head>
<body>
  <header class="gv-header">
    <h1>{{ title }}</h1>
    {% if meta_subtitle %}<div class="gv-meta">{{ meta_subtitle }}</div>{% endif %}
    {% if counts %}
    <div class="gv-counts">
      {% for label, n in counts %}
      <span class="gv-chip severity-{{ label }}">{{ label }}: {{ n }}</span>
      {% endfor %}
      {% if issues %}<span class="gv-chip">{{ located_count }} on map · {{ unlocated|length }} unlocated</span>{% endif %}
    </div>
    {% endif %}
  </header>
  <main>
    <section class="gv-map-section">
      <div id="gv-map"></div>
    </section>

    {% if unlocated %}
    <aside class="gv-unlocated">
      <h2>Unlocated findings ({{ unlocated|length }})</h2>
      <ul>
        {% for issue in unlocated %}
        <li data-unlocated-issue-id="{{ issue.issue_id }}">
          <span class="gv-sev severity-{{ issue.severity }}">{{ issue.severity|upper }}</span>
          <span class="gv-code">{{ issue.code }}</span> — {{ issue.message }}
        </li>
        {% endfor %}
      </ul>
    </aside>
    {% endif %}

    {% if issues %}
    <section class="gv-table-section">
      <h2>Findings ({{ issues|length }})</h2>
      <div class="gv-filters">
        <label>Severity
          <select id="gv-filter-severity">
            <option value="">all</option>
            {% for s in filter_options.severity %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
          </select>
        </label>
        <label>Table
          <select id="gv-filter-table">
            <option value="">all</option>
            {% for t in filter_options.table %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
          </select>
        </label>
        <label>Search
          <input id="gv-filter-search" type="search" placeholder="message or code…">
        </label>
      </div>
      <table class="gv-issues">
        <thead>
          <tr>
            <th>Severity</th>
            <th>Code</th>
            <th>Table</th>
            <th>Row</th>
            <th>Message</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {% for issue in issues %}
          <tr data-issue-id="{{ issue.issue_id }}"
              data-severity="{{ issue.severity }}"
              data-table="{{ issue.table or '' }}">
            <td><span class="gv-sev severity-{{ issue.severity }}">{{ issue.severity|upper }}</span></td>
            <td><span class="gv-code">{{ issue.code }}</span></td>
            <td>{{ issue.table or '' }}{% if issue.column %}:{{ issue.column }}{% endif %}</td>
            <td>{% if issue.row is not none %}{{ issue.row }}{% endif %}</td>
            <td>
              {{ issue.message }}
              {% if issue.fix_hint %}<div class="gv-fixhint">&rarr; {{ issue.fix_hint }}</div>{% endif %}
            </td>
            <td>
              {% if issue.edit_url %}<a class="gv-osm-link" href="{{ issue.edit_url }}" target="_blank" rel="noopener noreferrer">Edit in OSM</a>{% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
    {% endif %}
  </main>

  <script>{{ leaflet_js|safe }}</script>
  <script>window.__GMNSPY_DATA__ = {{ payload_json|safe }};</script>
  <script>{{ map_js|safe }}</script>
</body>
</html>
